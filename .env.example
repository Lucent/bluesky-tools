# The archive to serve: the did:plc:… (or did:web:…) folder name in this repo —
# the directory containing app.bsky.feed.post/. It's the only per-account config.
ARCHIVE_DID=

# Cloudflare Tunnel token for serving this publicly.
# Create a tunnel at https://one.dash.cloudflare.com/ > Networks > Tunnels,
# add a public hostname routing to http://thread-browser:8000,
# then copy the token here as .env (cp .env.example .env).
TUNNEL_TOKEN=
